# OpenAI API (server-only, no VITE_ prefix)
# Esta chave é usada APENAS no servidor Vercel (api/correction/deep-evaluation.ts)
# Nunca adicione prefixo VITE_ ou exponha esta chave no frontend
OPENAI_API_KEY=sk-your-key-here

# Modelo OpenAI para avaliação profunda
# Opções: gpt-4o-mini (recomendado custo-benefício), gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini