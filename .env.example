# =============================================================================
# NEXORA — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# Variáveis marcadas como [OBRIGATÓRIA] devem ser definidas para o app funcionar.
# Variáveis marcadas como [OPCIONAL] possuem valor padrão no código.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Auth + Database)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA] URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [OBRIGATÓRIA] Chave anônima do Supabase (segura para uso no browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# [OBRIGATÓRIA] Service Role Key (NUNCA exponha no frontend — apenas server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA] URL pública da aplicação (usada em emails, webhooks, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPCIONAL] Nome exibido na UI e em comunicações
NEXT_PUBLIC_APP_NAME=Nexora

# -----------------------------------------------------------------------------
# Mercado Pago — Billing SaaS (credenciais da Nexora como merchant)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para billing] Access Token do Mercado Pago para assinaturas recorrentes
MP_SAAS_ACCESS_TOKEN=APP_USR-xxxx...

# [OBRIGATÓRIA para webhook] Segredo para verificação de assinatura do webhook MP
MP_SAAS_WEBHOOK_SECRET=webhook-secret-here

# [OPCIONAL] URL da API do Mercado Pago (default: https://api.mercadopago.com)
MP_SAAS_API_URL=https://api.mercadopago.com

# -----------------------------------------------------------------------------
# Anthropic AI — Assistente IA (Fase 11)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para IA] Chave da API Anthropic para o assistente inteligente
ANTHROPIC_API_KEY=sk-ant-xxxx...

# [OPCIONAL] Modelo Anthropic a ser usado (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# App Mobile (Expo / React Native)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA para mobile] Mesma URL do Supabase usada no web
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [OBRIGATÓRIA para mobile] Mesma chave anônima usada no web
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here