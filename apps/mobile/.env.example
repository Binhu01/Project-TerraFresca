# Nexora Mobile — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.

# Supabase (mesmo projeto da versão Web)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica-aqui

# ⚠️ NUNCA coloque aqui:
# - SUPABASE_SERVICE_ROLE_KEY
# - ANTHROPIC_API_KEY
# - Segredos de OAuth / provedores externos
# - Chaves privadas de qualquer tipo